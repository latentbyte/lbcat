# Optional default browser: exact connection ID (zen-01) or browser name (zen) when only one
# of that browser is connected. CLI --browser overrides it.
BROWSER_CONTROL_BROWSER=

# Optional default task session ID. CLI --session overrides it.
# Set from `browser-control --browser <id> session begin`; not loaded automatically.
BROWSER_CONTROL_SESSION=

# Optional task label shown on agent-owned tabs. `session begin --label` overrides it.
BROWSER_CONTROL_LABEL=
