# Optional default browser: exact connection ID (zen-01) or browser name (zen) when only one
# of that browser is connected. CLI --browser overrides it; both override the session handle's browser.
BROWSER_CONTROL_BROWSER=

# Optional default task session handle (zen:ab12cd34); its browser prefix routes commands.
# CLI --session overrides it. Set from `browser-control session begin`; not loaded automatically.
BROWSER_CONTROL_SESSION=

# Optional task label shown on agent-owned tabs. `session begin --label` overrides it.
BROWSER_CONTROL_LABEL=
