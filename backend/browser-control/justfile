# browser-control justfile -- build Go binaries for the native messaging bridge

default:
    @just --list

# build all three Go binaries
build:
    go build -o bin/browser-control ./cmd/browser-control
    go build -o bin/browser-control-daemon ./cmd/browser-control-daemon
    go build -o bin/lbcat-shim ./cmd/lbcat-shim

# build, copy to ~/.local/bin, and register native host manifests
install: build
    mkdir -p ~/.local/bin
    cp bin/browser-control bin/browser-control-daemon bin/lbcat-shim ~/.local/bin/
    ln -sf browser-control ~/.local/bin/bctl
    # re-sign after copy so macOS code signing monitor doesn't kill them
    codesign --sign - --force ~/.local/bin/browser-control ~/.local/bin/browser-control-daemon ~/.local/bin/lbcat-shim
    ~/.local/bin/browser-control install --dev

# run Go tests
test:
    go test ./...

# run all static analysis (go vet)
check:
    go vet ./...

alias lint := check

# format Go code
fmt:
    gofumpt -w . || gofmt -w .

alias format := fmt
alias fix := fmt

# start the daemon in foreground (ctrl+c to stop)
dev: build
    ./bin/browser-control-daemon

# clean Go build artifacts
clean:
    rm -rf bin/
