# optional Browser Control userscript archive directory
BROWSER_CONTROL_SCRIPTS_DIR=

# optional fallback base for Browser Control userscript archive, uses $DOTFILES_DIR/user-scripts
DOTFILES_DIR=

# optional runtime state base, Browser Control uses $XDG_STATE_HOME/browser-control
XDG_STATE_HOME=

# optional lbcat-shim browser metadata overrides
BROWSER_CONTROL_BROWSER=
BROWSER_CONTROL_EXTENSION_ID=
BROWSER_CONTROL_PROFILE=
BROWSER_CONTROL_MANIFEST_VERSION=
